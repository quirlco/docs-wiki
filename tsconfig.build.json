{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": false,
    "removeComments": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/fixtures",
    "src/test-helpers.ts",
    "dist",
    "node_modules"
  ]
}
